{
  "expo": {
    "name": "Mama’s Shop",
    "slug": "mamas-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/app-icon.png",
    "scheme": "mamasshop",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7FC",
    "primaryColor": "#5B43D6",
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#FCFDFF",
        "foregroundImage": "./assets/images/brand/android-foreground.png",
        "monochromeImage": "./assets/images/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFDFF",
          "image": "./assets/images/brand/Mama’s Shop Speedy Cart Logo.png",
          "imageWidth": 280
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
